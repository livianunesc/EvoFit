# Copie para .env; nunca publique senhas reais. Process env prevalece.
# Padrões locais do XAMPP. Ajuste conforme seu banco.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=evofit
DB_USER=root
DB_PASSWORD=
APP_TIMEZONE=America/Sao_Paulo
SECURE_COOKIE=0
# Somente necessário para contas migradas da versão SQLite (primeiro login).
# No Windows, use caminho absoluto caso python não esteja no PATH.
# PYTHON_BIN=C:\Users\SEU_USUARIO\AppData\Local\Programs\Python\Python313\python.exe
# Para Docker Compose, defina uma senha forte antes de iniciar:
DOCKER_DB_PASSWORD=
