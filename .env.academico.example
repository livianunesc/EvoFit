# SOMENTE execução local (Python + MySQL/XAMPP). Copie para .env.academico.
# Preserve qualquer arquivo existente; nunca publique credenciais reais.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=evofit_academico
DB_USER=root
DB_PASSWORD=
# Se php não estiver no PATH, no Windows:
# PHP_BIN=C:\xampp\php\php.exe
# Docker usa ACADEMIC_DB_PASSWORD gerado por tools/preparar_academico.py.
